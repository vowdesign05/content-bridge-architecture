{% comment %}
  Content Bridge Post (App Block)
  Layout options:
    - Container style (theme-dependent wrapper class)
    - Columns (1-5)
    - Vertical padding (S/M/L)
    - Heading mode (theme/custom/none)
{% endcomment %}

{%- liquid
  assign container_mode = block.settings.container_mode
  assign cols = block.settings.columns | default: 4
  assign pad = block.settings.padding_y | default: 'm'
  assign heading_mode = block.settings.heading_mode | default: 'custom'
  assign heading_size = block.settings.heading_size | default: 'theme'
  assign custom_max_width = block.settings.custom_max_width | default: 1200

  assign pad_y_value = '40px'
  if pad == 's'
    assign pad_y_value = '24px'
  elsif pad == 'l'
    assign pad_y_value = '64px'
  endif

  assign section_class = 'cb-related'
  if heading_size != 'theme'
    assign section_class = section_class | append: ' cb-related--heading-' | append: heading_size
  endif
  if container_mode == 'custom'
    assign section_class = section_class | append: ' cb-related--width-custom'
  endif
-%}

<section
  class="{{ section_class }}"
  data-cb
  data-limit="{{ block.settings.limit }}"
  data-tax="{{ block.settings.tax }}"
  data-term-source="{{ block.settings.term_source }}"
  data-term-custom="{{ block.settings.term_custom | escape }}"
  data-term-minlen="{{ block.settings.term_minlen }}"
  data-fallback-latest="{{ block.settings.fallback_latest }}"
  style="--cb-cols: {{ cols }}; --cb-pad-y: {{ pad_y_value }}; --cb-custom-width: {{ custom_max_width }}px;"
>
  {%- assign inner_class = 'cb-related__inner' -%}
  {%- if container_mode == 'theme_page_width' -%}
    {%- assign inner_class = inner_class | append: ' page-width' -%}
  {%- elsif container_mode == 'theme_container' -%}
    {%- assign inner_class = inner_class | append: ' container' -%}
  {%- endif -%}

  <div class="{{ inner_class }}">
    {% if heading_mode == 'custom' and block.settings.heading != blank %}
      <h2
        class="cb-related__heading"
        data-cb-heading
        data-default-heading="{{ block.settings.heading | escape }}"
        data-fallback-heading="{{ block.settings.fallback_heading | escape }}"
      >
        {{ block.settings.heading }}
      </h2>
    {% endif %}

    <div class="cb-related__grid" data-cb-grid></div>
  </div>
</section>

<style>
  .cb-related { padding: var(--cb-pad-y) 0; }
  .cb-related__inner { }
  .cb-related--width-custom .cb-related__inner {
    max-width: var(--cb-custom-width);
    margin-left: auto;
    margin-right: auto;
    padding-left: 16px;
    padding-right: 16px;
  }
  .cb-related__heading { margin: 0 0 16px; }
  .cb-related--heading-sm .cb-related__heading { font-size: 1.125rem; line-height: 1.3; }
  .cb-related--heading-md .cb-related__heading { font-size: 1.4rem; line-height: 1.3; }
  .cb-related--heading-lg .cb-related__heading { font-size: 1.8rem; line-height: 1.25; }
  .cb-related--heading-xl .cb-related__heading { font-size: 2.2rem; line-height: 1.2; }

  .cb-related__grid {
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(var(--cb-cols), minmax(0, 1fr));
  }
  @media (max-width: 990px) {
    .cb-related__grid {
      grid-template-columns: repeat(min(var(--cb-cols), 2), minmax(0, 1fr));
    }
  }
  @media (max-width: 640px) {
    .cb-related__grid { grid-template-columns: 1fr; }
  }

  .cb-card {
    display: block;
    border: 1px solid rgba(0,0,0,.12);
    border-radius: 12px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
  }
  .cb-card__thumb { aspect-ratio: 16/9; background: rgba(0,0,0,.04); }
  .cb-card__thumb img { width: 100%; height: 100%; object-fit: cover; display:block; }
  .cb-card__body { padding: 12px 12px 14px; }
  .cb-card__title { font-size: 1rem; line-height: 1.35; margin: 0 0 8px; }
  .cb-card__meta { font-size: .85rem; opacity: .7; margin: 0 0 8px; }
  .cb-card__excerpt { font-size: .92rem; line-height: 1.5; opacity: .9; margin: 0; }
</style>

<script>
(() => {
  const blocks = document.querySelectorAll('[data-cb]');
  if (!blocks.length) return;

  const productData = {
    vendor: {{ product.vendor | json }},
    product_type: {{ product.type | json }},
    tags: {{ product.tags | json }},
    collections: {{ product.collections | map: 'handle' | json }},
    handle: {{ product.handle | json }},
    cb_term: {{ product.metafields.custom.content_bridge.value | default: "" | json }}
  };

  const normalizeTerm = (s) =>
    (s || '')
      .toString()
      .trim()
      .replace(/\s+/g, '-')
      .toLowerCase();

  const stripHtml = (html) => {
    const d = document.createElement('div');
    d.innerHTML = html || '';
    return (d.textContent || d.innerText || '').trim();
  };

  const escapeHtml = (s) =>
    (s || '').replace(/[&<>"']/g, (c) => ({
      '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;'
    }[c]));

  const formatDate = (iso) => {
    if (!iso) return '';
    const dt = new Date(iso);
    if (Number.isNaN(dt.getTime())) return '';
    return dt.toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: '2-digit' });
  };

  const cardHtml = (item) => {
    const title = escapeHtml(item.title || '');
    const url = item.url || '#';
    const date = formatDate(item.date);
    const rawExcerpt = stripHtml(item.excerpt || '');
    const excerpt = escapeHtml(rawExcerpt).slice(0, 140);
    const img = item.image || '';

    return `
      <a class="cb-card" href="${url}">
        <div class="cb-card__thumb">
          ${img ? `<img src="${img}" alt="${title}" loading="lazy" />` : ``}
        </div>
        <div class="cb-card__body">
          ${date ? `<p class="cb-card__meta">${date}</p>` : `<p class="cb-card__meta"></p>`}
          <p class="cb-card__title">${title}</p>
          ${excerpt ? `<p class="cb-card__excerpt">${excerpt}${(rawExcerpt.length > 140) ? '…' : ''}</p>` : ``}
        </div>
      </a>
    `;
  };

  const fetchJson = async (url) => {
    try {
      const r = await fetch(url, { credentials: 'same-origin' });
      if (!r.ok) return null;
      return await r.json();
    } catch (e) {
      return null;
    }
  };


  blocks.forEach((el) => {
    const grid = el.querySelector('[data-cb-grid]');
    if (!grid) return;

    const headingEl = el.querySelector('[data-cb-heading]');
    const tax = (el.dataset.tax || '').trim();
    const limit = String(el.dataset.limit || '4');
    const termSource = (el.dataset.termSource || 'vendor').trim();
    const termCustom = (el.dataset.termCustom || '').trim();
    const fallbackLatest = (el.dataset.fallbackLatest || 'false') === 'true';
    const termMinlen = parseInt(el.dataset.termMinlen || '0', 10) || 0;

    const latestUrl = `/apps/content-bridge/posts?limit=${encodeURIComponent(limit)}`;

    const setHeading = (mode) => {
      if (!headingEl) return;
      const def = headingEl.dataset.defaultHeading || headingEl.textContent || '';
      const fb  = headingEl.dataset.fallbackHeading || 'Latest posts';
      headingEl.textContent = (mode === 'fallback') ? fb : def;
    };

    const renderItems = (items, mode) => {
      if (!items || !items.length) { el.style.display = 'none'; return; }
      setHeading(mode || 'default');
      grid.innerHTML = items.map(cardHtml).join('');
    };

    // A) tax empty -> always latest
    if (!tax) {
      fetchJson(latestUrl).then((data) => renderItems(data?.items || [], 'default'));
      return;
    }

    // term decide: metafield -> fallback
    let term = normalizeTerm(productData.cb_term);

    if (!term) {
      if (termSource === 'vendor') term = normalizeTerm(productData.vendor);
      else if (termSource === 'product_type') term = normalizeTerm(productData.product_type);
      else if (termSource === 'first_tag') term = normalizeTerm(productData.tags?.[0] || '');
      else if (termSource === 'collection_handle') term = normalizeTerm(productData.collections?.[0] || '');
      else if (termSource === 'custom') term = normalizeTerm(termCustom);
    }

    const termInvalid = (!term) || (termMinlen && term.length < termMinlen);

    // B) term invalid -> fallbackLatest
    if (termInvalid) {
      if (!fallbackLatest) { el.style.display = 'none'; return; }
      fetchJson(latestUrl).then((data2) => renderItems(data2?.items || [], 'fallback'));
      return;
    }

    // C) filtered
    const filteredUrl =
      `/apps/content-bridge/posts?limit=${encodeURIComponent(limit)}&tax=${encodeURIComponent(tax)}&term=${encodeURIComponent(term)}`;

    fetchJson(filteredUrl).then((data) => {
      const items = data?.items || [];
      if (items.length) { renderItems(items, 'default'); return; }
      if (!fallbackLatest) { el.style.display = 'none'; return; }
      fetchJson(latestUrl).then((data2) => renderItems(data2?.items || [], 'fallback'));
    });
  });
})();
</script>

{% schema %}
{
  "name": "t:content_bridge_post.name",
  "target": "section",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    {
        "type": "select",
        "id": "heading_mode",
        "label": "t:content_bridge_post.settings.heading_mode.label",
        "default": "custom",
        "options": [
            { "value": "custom", "label": "t:content_bridge_post.settings.heading_mode.options.custom" },
            { "value": "none", "label": "t:content_bridge_post.settings.heading_mode.options.none" }
        ],
        "info": "t:content_bridge_post.settings.heading_mode.info"
    },

    {
      "type": "text",
      "id": "heading",
      "label": "t:content_bridge_post.settings.heading.label",
      "default": "Related articles"
    },
    {
      "type": "text",
      "id": "fallback_heading",
      "label": "t:content_bridge_post.settings.fallback_heading.label",
      "default": "Latest posts"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "t:content_bridge_post.settings.heading_size.label",
      "default": "theme",
      "options": [
        { "value": "theme", "label": "t:content_bridge_post.settings.heading_size.options.theme" },
        { "value": "sm", "label": "t:content_bridge_post.settings.heading_size.options.sm" },
        { "value": "md", "label": "t:content_bridge_post.settings.heading_size.options.md" },
        { "value": "lg", "label": "t:content_bridge_post.settings.heading_size.options.lg" },
        { "value": "xl", "label": "t:content_bridge_post.settings.heading_size.options.xl" }
      ],
      "info": "t:content_bridge_post.settings.heading_size.info"
    },

    {
      "type": "select",
      "id": "container_mode",
      "label": "t:content_bridge_post.settings.container_mode.label",
      "default": "none",
      "options": [
        { "value": "none", "label": "t:content_bridge_post.settings.container_mode.options.none" },
        { "value": "theme_page_width", "label": "t:content_bridge_post.settings.container_mode.options.page_width" },
        { "value": "theme_container", "label": "t:content_bridge_post.settings.container_mode.options.container" },
        { "value": "custom", "label": "t:content_bridge_post.settings.container_mode.options.custom" }
      ],
      "info": "t:content_bridge_post.settings.container_mode.info"
    },
    {
      "type": "range",
      "id": "custom_max_width",
      "label": "t:content_bridge_post.settings.custom_max_width.label",
      "min": 720,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "default": 1200,
      "info": "t:content_bridge_post.settings.custom_max_width.info"
    },

    {
      "type": "range",
      "id": "columns",
      "label": "t:content_bridge_post.settings.columns.label",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 4
    },

    {
      "type": "select",
      "id": "padding_y",
      "label": "t:content_bridge_post.settings.padding_y.label",
      "default": "m",
      "options": [
        { "value": "s", "label": "t:content_bridge_post.settings.padding_y.options.s" },
        { "value": "m", "label": "t:content_bridge_post.settings.padding_y.options.m" },
        { "value": "l", "label": "t:content_bridge_post.settings.padding_y.options.l" }
      ]
    },

    {
      "type": "range",
      "id": "limit",
      "label": "t:content_bridge_post.settings.limit.label",
      "min": 1,
      "max": 12,
      "step": 1,
      "default": 4
    },

    {
      "type": "select",
      "id": "tax",
      "label": "t:content_bridge_post.settings.tax.label",
      "default": "",
      "options": [
        { "value": "", "label": "t:content_bridge_post.settings.tax.options.latest" },
        { "value": "category", "label": "t:content_bridge_post.settings.tax.options.category" },
        { "value": "tag", "label": "t:content_bridge_post.settings.tax.options.tag" }
      ],
      "info": "t:content_bridge_post.settings.tax.info"
    },

    {
      "type": "select",
      "id": "term_source",
      "label": "t:content_bridge_post.settings.term_source.label",
      "default": "vendor",
      "options": [
        { "value": "vendor", "label": "t:content_bridge_post.settings.term_source.options.vendor" },
        { "value": "product_type", "label": "t:content_bridge_post.settings.term_source.options.product_type" },
        { "value": "first_tag", "label": "t:content_bridge_post.settings.term_source.options.first_tag" },
        { "value": "collection_handle", "label": "t:content_bridge_post.settings.term_source.options.collection_handle" },
        { "value": "custom", "label": "t:content_bridge_post.settings.term_source.options.custom" }
      ],
      "info": "t:content_bridge_post.settings.term_source.info"
    },

    {
      "type": "text",
      "id": "term_custom",
      "label": "t:content_bridge_post.settings.term_custom.label",
      "info": "t:content_bridge_post.settings.term_custom.info"
    },

    {
      "type": "range",
      "id": "term_minlen",
      "label": "t:content_bridge_post.settings.term_minlen.label",
      "min": 0,
      "max": 50,
      "step": 1,
      "default": 0,
      "info": "t:content_bridge_post.settings.term_minlen.info"
    },

    {
      "type": "checkbox",
      "id": "fallback_latest",
      "label": "t:content_bridge_post.settings.fallback_latest.label",
      "default": false
    }
  ]
}
{% endschema %}
